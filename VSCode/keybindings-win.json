// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+m ctrl+,",
    "command": "toggle",
    "when": "editorTextFocus",
    "args": {
      "id": "editor.rulers",
      "value": [
        {
          "editor.rulers": [100, 107]
        },
        {
          "editor.rulers": []
        }
      ]
    }
  },
  {
    "key": "shift+space",
    "command": "extension.aceJump",
    "when": "editorTextFocus"
  },

  {
    "key": "alt+i",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "alt+k",
    "command": "Edit.LineDown",
    "when": "editorTextFocus"
  },

  {
    "key": "alt+i",
    "command": "cursorUp",
    "when": "textInputFocus"
  },
  {
    "key": "alt+k",
    "command": "cursorDown",
    "when": "textInputFocus"
  },
  {
    "key": "alt+j",
    "command": "cursorWordStartLeft",
    "when": "textInputFocus"
  },
  {
    "key": "alt+l",
    "command": "cursorWordEndRight",
    "when": "textInputFocus"
  },
  {
    "key": "alt+h",
    "command": "cursorHome",
    "when": "textInputFocus"
  },
  {
    "key": "alt+;",
    "command": "cursorEnd",
    "when": "textInputFocus"
  },
  {
    "key": "alt+u",
    "command": "cursorLeft",
    "when": "textInputFocus"
  },
  {
    "key": "alt+o",
    "command": "cursorRight",
    "when": "textInputFocus"
  },
  {
    "key": "alt+p",
    "command": "editorScroll",
    "args": {
      "to": "up",
      "by": "line",
      "revealCursor": true,
      "value": 5
    }
  },
  {
    "key": "alt+n",
    "command": "editorScroll",
    "args": {
      "to": "down",
      "by": "line",
      "revealCursor": true,
      "value": 5
    }
  },
  {
    "key": "ctrl+alt+p",
    "command": "cursorPageUp",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+alt+n",
    "command": "cursorPageDown",
    "when": "textInputFocus"
  },

  {
    "key": "shift+alt+i",
    "command": "cursorUpSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+k",
    "command": "cursorDownSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+j",
    "command": "cursorWordStartLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+l",
    "command": "cursorWordEndRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+h",
    "command": "cursorHomeSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+;",
    "command": "cursorEndSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+u",
    "command": "cursorLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+o",
    "command": "cursorRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+p",
    "command": "cursorPageUpSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+n",
    "command": "cursorPageDownSelect",
    "when": "textInputFocus"
  },

  {
    "key": "ctrl+alt+j",
    "command": "workbench.action.focusLeftGroup"
  },
  {
    "key": "ctrl+alt+l",
    "command": "workbench.action.focusRightGroup"
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.nextEditorInGroup"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.previousEditorInGroup"
  },

  {
    "key": "ctrl+k shift+alt+j",
    "command": "workbench.action.moveEditorToLeftGroup"
  },
  {
    "key": "ctrl+k shift+alt+l",
    "command": "workbench.action.moveEditorToRightGroup"
  },

  {
    "key": "ctrl+f7",
    "command": "editor.action.toggleTabFocusMode"
  },
  {
    "key": "ctrl+m",
    "command": "-editor.action.toggleTabFocusMode"
  }
]
