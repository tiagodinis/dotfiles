// Place your key bindings in this file to override the defaults
[
  {
    "key": "meta+i",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "meta+k",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "shift+space",
    "command": "extension.aceJump",
    "when": "editorTextFocus"
  },
  {
    "key": "meta+i",
    "command": "cursorUp",
    "when": "textInputFocus && !suggestWidgetVisible"
  },
  {
    "key": "meta+k",
    "command": "cursorDown",
    "when": "textInputFocus && !suggestWidgetVisible"
  },
  {
    "key": "meta+u",
    "command": "cursorLeft",
    "when": "textInputFocus"
  },
  {
    "key": "meta+o",
    "command": "cursorRight",
    "when": "textInputFocus"
  },
  {
    "key": "meta+j",
    "command": "cursorWordStartLeft",
    "when": "textInputFocus"
  },
  {
    "key": "meta+l",
    "command": "cursorWordEndRight",
    "when": "textInputFocus"
  },
  {
    "key": "meta+h",
    "command": "cursorHome",
    "when": "textInputFocus"
  },
  {
    "key": "meta+;",
    "command": "cursorEnd",
    "when": "textInputFocus"
  },
  {
    "key": "meta+[",
    "command": "editorScroll",
    "args": {
      "to": "up",
      "by": "line",
      "revealCursor": true,
      "value": 5
    }
  },
  {
    "key": "meta+]",
    "command": "editorScroll",
    "args": {
      "to": "down",
      "by": "line",
      "revealCursor": true,
      "value": 5
    }
  },
  {
    "key": "shift+meta+i",
    "command": "cursorUpSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+meta+k",
    "command": "cursorDownSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+meta+u",
    "command": "cursorLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+meta+o",
    "command": "cursorRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+meta+j",
    "command": "cursorWordStartLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+meta+l",
    "command": "cursorWordEndRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+meta+h",
    "command": "cursorHomeSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+meta+;",
    "command": "cursorEndSelect",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.nextEditorInGroup"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.previousEditorInGroup"
  },
  {
    "key": "ctrl+k ctrl+meta+j",
    "command": "workbench.action.moveEditorToLeftGroup"
  },
  {
    "key": "ctrl+k ctrl+meta+l",
    "command": "workbench.action.moveEditorToRightGroup"
  },
  {
    "key": "ctrl+i",
    "command": "editor.action.showHover",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+i",
    "command": "editor.action.revealDefinition",
    "when": "editorHasDefinitionProvider && editorTextFocus"
  },
  {
    "key": "ctrl+m ctrl+.",
    "command": "agentSessions.toggleAgentSessionsSidebar"
  },
  {
    "key": "shift+meta+b",
    "command": "workbench.action.toggleAuxiliaryBar"
  },
  {
    "key": "ctrl+p",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+shift+p",
    "command": "-workbench.action.showCommands"
  },
  {
    "key": "meta+p",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "shift+meta+p",
    "command": "workbench.action.showCommands"
  },
  {
    "key": "meta+b",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "meta+m",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "inChat"
  },
  {
    "key": "meta+m",
    "command": "workbench.action.chat.open",
    "when": "!inChat && !chatSetupDisabled && !chatSetupHidden",
    "args": { "mode": "agent" }
  },
  {
    "key": "shift+meta+m",
    "command": "workbench.action.toggleMaximizedAuxiliaryBar"
  },
  { "key": "shift+meta+e", "command": "workbench.view.explorer" },
  { "key": "shift+meta+g", "command": "workbench.view.scm" },
  { "key": "shift+meta+d", "command": "workbench.view.debug" },
  { "key": "shift+meta+x", "command": "workbench.view.extensions" },
  {
    "key": "meta+/",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus"
  }
]
