// Place your key bindings in this file to override the defaults
[
  {
    "key": "cmd+i",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "cmd+k",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "shift+space",
    "command": "extension.aceJump",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+i",
    "command": "cursorUp",
    "when": "textInputFocus && !suggestWidgetVisible"
  },
  {
    "key": "cmd+k",
    "command": "cursorDown",
    "when": "textInputFocus && !suggestWidgetVisible"
  },
  {
    "key": "cmd+u",
    "command": "cursorLeft",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+o",
    "command": "cursorRight",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+j",
    "command": "cursorWordStartLeft",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+l",
    "command": "cursorWordEndRight",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+h",
    "command": "cursorHome",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+;",
    "command": "cursorEnd",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+[",
    "command": "editorScroll",
    "args": {
      "to": "up",
      "by": "line",
      "revealCursor": true,
      "value": 5
    }
  },
  {
    "key": "cmd+]",
    "command": "editorScroll",
    "args": {
      "to": "down",
      "by": "line",
      "revealCursor": true,
      "value": 5
    }
  },
  {
    "key": "shift+cmd+i",
    "command": "cursorUpSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+k",
    "command": "cursorDownSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+u",
    "command": "cursorLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+o",
    "command": "cursorRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+j",
    "command": "cursorWordStartLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+l",
    "command": "cursorWordEndRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+h",
    "command": "cursorHomeSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+;",
    "command": "cursorEndSelect",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.nextEditorInGroup"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.previousEditorInGroup"
  },
  {
    "key": "ctrl+k ctrl+cmd+j",
    "command": "workbench.action.moveEditorToLeftGroup"
  },
  {
    "key": "ctrl+k ctrl+cmd+l",
    "command": "workbench.action.moveEditorToRightGroup"
  },
  {
    "key": "ctrl+i",
    "command": "editor.action.showHover",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+i",
    "command": "editor.action.revealDefinition",
    "when": "editorHasDefinitionProvider && editorTextFocus"
  },
  {
    "key": "cmd+m cmd+1",
    "command": "inlineChat.start",
    "when": "editorFocus && inlineChatHasEditsAgent && inlineChatPossible && !editorReadonly && !editorSimpleInput || editorFocus && inlineChatHasNotebookAgent && inlineChatPossible && !editorReadonly && !editorSimpleInput && activeEditor == 'workbench.editor.notebook' || editorFocus && inlineChatHasNotebookInline && inlineChatPossible && !editorReadonly && !editorSimpleInput && activeEditor == 'workbench.editor.notebook'"
  },
  {
    "key": "cmd+m cmd+2",
    "command": "workbench.action.openQuickChat"
  },
  {
    "key": "cmd+m cmd+3",
    "command": "workbench.action.chat.open",
    "when": "!chatSetupDisabled && !chatSetupHidden",
    "args": { "mode": "ask" }
  },
  {
    "key": "cmd+m cmd+4",
    "command": "workbench.action.chat.open",
    "when": "!chatSetupDisabled && !chatSetupHidden",
    "args": { "mode": "edit" }
  },
  {
    "key": "cmd+m cmd+5",
    "command": "workbench.action.chat.open",
    "when": "!chatSetupDisabled && !chatSetupHidden",
    "args": { "mode": "agent" }
  },
  {
    "key": "ctrl+m ctrl+.",
    "command": "agentSessions.toggleAgentSessionsSidebar"
  },
  {
    "key": "shift+cmd+b",
    "command": "workbench.action.toggleAuxiliaryBar"
  },
  {
    "key": "shift+cmd+t",
    "command": "todo-tree-view.focus"
  },
  {
    "key": "ctrl+m ctrl+,",
    "command": "toggle",
    "when": "editorTextFocus",
    "args": {
      "id": "editor.rulers",
      "value": [
        {
          "editor.rulers": [90, 96]
        },
        {
          "editor.rulers": []
        }
      ]
    }
  }
]
