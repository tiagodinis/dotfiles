{
	"window.enableMenuBarMnemonics": false,
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"git.enabled": true,
	"javascript.updateImportsOnFileMove.enabled": "always",
	"telemetry.telemetryLevel": "off",
	"editor.acceptSuggestionOnCommitCharacter": false,
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "explicit"
	},
	"editor.codeLens": false,
	"editor.cursorBlinking": "expand",
	"editor.defaultFormatter": "biomejs.biome",
	"editor.fontSize": 16,
	"editor.formatOnSave": true,
	"[css]": {
		"editor.defaultFormatter": null
	},
	"editor.guides.indentation": false,
	"editor.minimap.enabled": false,
	"editor.overviewRulerBorder": false,
	"editor.renderLineHighlight": "none",
	"editor.wordWrap": "on",
	"stylelint.validate": ["css", "less", "postcss", "javascript"],
	"window.commandCenter": false,
	"workbench.colorTheme": "Yitzchok (rainglow)",
	"zenMode.centerLayout": true,
	"cSpell.userWords": [
		"Aberrated",
		"antiquewhite",
		"autodocs",
		"crossorigin",
		"denormalized",
		"dependees",
		"Divs",
		"Earthsong",
		"esbenp",
		"fxaa",
		"glsl",
		"Headshot",
		"helvetica",
		"hoverable",
		"interactable",
		"lerp",
		"lightsabers",
		"linaria",
		"lixo",
		"millis",
		"msaa",
		"mult",
		"nunito",
		"pomodoro",
		"pomodoros",
		"rainglow",
		"Renderable",
		"smaa",
		"ssaa",
		"stylelint",
		"svgs",
		"templating",
		"tiagodinis",
		"tweakable",
		"Tweakpane",
		"xico"
	],
	"diffEditor.codeLens": true,
	"typescript.updateImportsOnFileMove.enabled": "always",
	"todo-tree.general.tags": [
		"!BUG",
		"BUG",
		"REVIEW",
		"FIXME",
		"TIDY",
		"TODO",
		"[ ]",
		"[x]",
		"!!!"
	],
	"typescript.preferences.importModuleSpecifier": "non-relative",
	"typescript.preferences.autoImportFileExcludePatterns": [],
	"todo-tree.highlights.customHighlight": {
		"FIXME": {
			"icon": "bug",
			"iconColour": "red"
		},
		"!BUG": {
			"icon": "bug",
			"iconColour": "red"
		},
		"BUG": {
			"icon": "bug",
			"iconColour": "orange"
		},
		"REVIEW": {
			"icon": "search",
			"iconColour": "mediumturquoise"
		},
		"TIDY": {
			"icon": "tools",
			"iconColour": "mediumpurple"
		},
		"TODO": {
			"icon": "issue-draft",
			"iconColour": "seagreen"
		},
		"[ ]": {
			"icon": "issue-draft",
			"iconColour": "seagreen"
		},
		"[x]": {
			"icon": "issue-closed",
			"iconColour": "seagreen"
		},
		"!!!": {
			"icon": "stop",
			"iconColour": "yellow"
		}
	},
	"gitlens.mode.active": "zen",
	"security.workspace.trust.untrustedFiles": "open",
	"editor.quickSuggestions": {
		"strings": true
	},
	"editor.suggestOnTriggerCharacters": true,
	"github.copilot.nextEditSuggestions.enabled": true,
	"github.copilot.enable": {
		"scminput": false
	},
	"chat.fontSize": 18,
	"chat.editor.fontSize": 14,
	"chat.agentHost.byokModels.enabled": true,
	"editor.rulers": [],
	"editor.accessibilitySupport": "off",
	"claudeCode.preferredLocation": "panel",
	"claudeCode.selectedModel": "default",
	"workbench.startupEditor": "none",
	"[markdown]": {
		"diffEditor.ignoreTrimWhitespace": false
	},
	"debug.breakpointsView.presentation": "tree",
	"terminal.integrated.fontFamily": "'MesloLGS NF', 'MesloLGS Nerd Font', 'JetBrainsMono NF', monospace",
	"terminal.integrated.defaultProfile.linux": "bash",
	"terminal.integrated.defaultProfile.osx": "zsh",
	"json.schemaDownload.trustedDomains": {
		"https://schemastore.azurewebsites.net/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://www.schemastore.org/": true,
		"https://json.schemastore.org/": true,
		"https://json-schema.org/": true,
		"https://developer.microsoft.com/json-schemas/": true,
		"https://biomejs.dev": true
	},
	"scm.repositories.selectionMode": "single",
	"chat.viewSessions.orientation": "stacked"
}
